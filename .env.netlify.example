# Variáveis de ambiente necessárias no painel do Netlify
# Acesse: Site Settings > Environment Variables

# Banco de dados (MySQL/TiDB ou outro MySQL-compatível)
DATABASE_URL=mysql://user:password@host:3306/dbname

# JWT para sessões
JWT_SECRET=sua_chave_secreta_aqui

# OAuth Manus (se usar autenticação)
VITE_APP_ID=seu_app_id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im

# Manus Forge API (se usar LLM/storage)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=

# Identificação do owner
OWNER_OPEN_ID=
OWNER_NAME=

# Analytics (opcional)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_APP_LOGO=
VITE_APP_TITLE=Portal Tá na Conta
